	DisplayName: 易碎骨头
	// Tooltip: ""
}

AltarExterminator: {
	DisplayName: 祭坛终结者
	Tooltip:
		'''
		破坏所有自然生成的恶魔祭坛和猩红祭坛
		会导致新三矿大量生成和幻灵大量生成等后果
		“也叫幻灵制造者”
		'''
}

AutoHouse: {
	DisplayName: 快速房屋
	Tooltip: 快速建造一间NPC房屋
}

BoomShuriken: {
	DisplayName: 爆炸手里剑
	Tooltip:
		'''
		接触物块时立即爆炸，破坏物块
		破坏能力和使用速度取决于背包里最强镐的镐力和使用速度，使用速度还会受挖掘速度加成
		“挖穿任何东西的最快方式永远是把它们炸飞！”
		'''
}

CityBuster: {
	DisplayName: 城市克星
	Tooltip:
		'''
		大面积破坏物块
		不会破坏背景墙
		不会破坏重要区域
		风险自担
		'''
}

DoubleObsidianInstabridge: {
	DisplayName: 双重黑曜石速建平台
	Tooltip:
		'''
		建造2条横跨整个世界的黑曜石平台
		同时清除平台之间和平台上方的区域
		下方的平台出现在鼠标位置
		不会破坏重要区域
		风险自担
		'''
}

GraveBuster: {
	DisplayName: 墓碑克星
	Tooltip: 大面积破坏墓碑
}

HalfInstavator: {
	DisplayName: 半程地狱直通车
	Tooltip:
		'''
		投掷一枚炸弹，建造一条直通地狱的半程通道
		在一定深度下不会生效
		不会破坏重要区域
		风险自担
		'''
}

InstaBridge: {
	DisplayName: 速建平台
	Tooltip:
		'''
		建造一条横跨整个世界的平台
		同时清除平台正上方的区域
		平台出现在鼠标位置
		不会破坏重要区域
		右键单击会清除这片区域但不放置平台
		风险自担
		'''
}

InstaTrack: {
	DisplayName: 速建轨道
	Tooltip:
		'''
		建造一条横跨整个世界的矿车轨道
		同时清除轨道正上方的区域
		轨道出现在鼠标位置
		不会破坏重要区域
		风险自担
		'''
}

Instavator: {
	DisplayName: 地狱直通车
	Tooltip:
		'''
		投掷一枚炸弹，建造一条直通地狱的通道
		不会破坏重要区域
		风险自担
		'''
}

LihzahrdInstactuationBomb: {
	DisplayName: 丛林神庙炸弹
	Tooltip:
		'''
		站在丛林祭坛前使用时，清除丛林蜥蜴祭坛周围的空间
		虚化丛林蜥蜴砖并摧毁其他物块
		仅能在世纪之花被击败后，在丛林神庙中使用
		'''
}

MiniInstaBridge: {
	DisplayName: 迷你速建平台
	Tooltip:
		'''
		在鼠标的高度建造一条长平台
		不会破坏任何方块
		'''
}

ObsidianInstaBridge: {
	DisplayName: 黑曜石速建平台
	Tooltip:
		'''
		建造一条横跨整个世界的黑曜石平台
		同时清除平台正上方的区域
		平台出现在鼠标位置
