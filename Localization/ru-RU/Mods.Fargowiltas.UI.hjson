LumberJack: {
	Biomes: {
		Purity: {
			Name: Лес
			Description: Нет ничего лучше рубки и посадки деревьев в лесу! С некоторых даже иногда выпадают разные предметы! Одна беда, божьи коровки вылезают на ветру и мешают мне, так что если они тебе понадобятся — могу отдать тебе.
		}

		Desert: {
			Name: Пустыня
			Description: Кактусы, значит, не деревья? Да ладно тебе, у некоторых даже есть цветочки на верхушке... Полагаю, красота в глазах рубящего, ха-ха!
		}

		Corrupt: {
			Name: Порча
			Description: Ненавижу, когда ты только находишь хорошее дерево в порче, рубишь его — а оно всё выедено этими гадкими микробами. Такая трата эбонитовой древесины... но когда ты находишь идеальное дерево — настроение только поднимается!
		}

		Crimson: {
			Name: Багрянец
			Description: Ко мне недавно подошёл какой-то чувак в тыкве, пока я рубил мрачную древесину, что-то там рассказывал про «Ад Данте». Если дерево красное и кровавое, это не значит, что в нём сидит человек! По крайней мере, я так сказал ему.
		}

		Hallow: {
			Name: Освящение
			Description: Обычно, кгда ты рубишь деревья, на пеньках есть клльца, которые показывают возраст дерева. А вот у жемчужной древесины вместо кольца звёзды! Разве не круто? Только постарайся там насекомых не убивать. Есть там кое-кто... кто очень о них заботится.
		}

		Snow: {
			Name: Тундра
			Description: Таёжная древесина — моя самая любимая древесина, собирать её то ещё удовольствие! Конечно, в метель рубить её тяжелее, но от этого становится только приятнее получить желанное!
		}

		Jungle: {
			Name: Джунгли
			Description: Джунгли — место опасное, только сунешься туда — сразу отовсюду летучие мыши летят, особенно ночью! Рубить деревья там вообще невозможно, только замахнёшься, а тебя уже окружили пчёлы! Но что-то я всё же да достаю оттуда!
		}

		Mushroom: {
			Name: Светящиеся грибы
			Description: Знаешь, грибы с биологической точки зрения ближе к человеку, чем к растениям. Но не думай, я не дискриминирую! Тебе стоит посадить пару семечек на поверхности, может кто да заявится!
		}

		Beach: {
			Name: Океан
			Description: Однажды, пока я собирал пальмовую древесину на берегу океана, мне прямо на голову с дерева упал кокос! И я тебе скажу, дело было неприятным, голова ещё неделю гудела! И поосторожнее с теми крабами, сами они маленькие, но кусаются по-адски больно!
		}

		Caverns: {
			Name: Подземелье
			Description: Пещеры? Ты что, хочешь, чтоб я своим топором камни рубил? Тогда тебе повезло! Мне не нужны эти самоцветы, я из них даже новый топор сделать не могу! Одно только удивляет, как эти зверьки так кристаллизуются... надеюсь, никто не начнёт охоту на их блестящий мех.
		}

		Underworld: {
			Name: Преисподняя
			Description: Ты хочешь, чтобы я пошёл прям в самый низ? Не переживай, в этот раз демоны не будут настолько глупы, чтобы помешать мне.
		}
	}

