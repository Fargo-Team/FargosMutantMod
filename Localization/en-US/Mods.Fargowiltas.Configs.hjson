FargoServerConfig: {
	DisplayName: Server Config

	Headers: {
		Gameplay: Gameplay Changes
		Content: New Content
		WorldStates: World States
		StatMultipliers: Stat Multipliers
		Misc: Miscellaneous
	}

	UnlimitedAmmo: {
		Label: "[i:771] Unlimited Ammo at 3996+ in Hardmode"
		Tooltip: Ammunition is not consumed if you have a stack of at least 3996, in Hardmode.
	}

	UnlimitedConsumableWeapons: {
		Label: "[i:42] Unlimited Consumable Weapons at 3996+ in Hardmode"
		Tooltip: All consumable weapons are not consumed if you have a stack of at least 3996, in Hardmode.
	}

	UnlimitedPotionBuffs: {
		Label: "[i:292] Unlimited Potion Buffs"
		Tooltip: Potions with buff durations of at least 2 minutes or more are granted infinitely.
	}

	UnlimitedPotionBuffsAmount: {
		Label: "[i:IronskinPotion] Unlimited Potion Buffs Amount"
		Tooltip: Stack size of potions that must be carried to grant infinite buffs.
	}

	EasySummons: {
		Label: "[i:Fargowiltas/SuspiciousSkull] Improved Boss Summons"
		Tooltip: Boss and event summon items ignore requirements and set the time to meet their requirements.
	}

	BossZen: {
		Label: "[i:3117] No enemies spawn during boss fights"
		Tooltip: ""
	}

	AnglerQuestInstantReset: {
		Label: "[i:2374] Angler Quest Instant Refresh"
		Tooltip: Angler quests instantly refresh when you complete an angler quest.
	}

	ExtraLures: {
		Label: "[i:2373] Extra Lures on Fishing Rods"
		Tooltip: Some higher tier Fishing Rods grant extra lures.
	}

	FasterLavaFishing: {
		Label: "[i:4881] Faster Fishing in Lava"
		Tooltip: Increases the speed of fishing in Lava liquid.
	}

	Fountains: {
		Label: "[i:909] Fountains Cause Biomes"
		Tooltip: Fountains cause the nearby area to count as their associated biome.
	}

	PermanentStationsNearby: {
		Label: "[i:3198] Automatic Station Buffs When Nearby"
		Tooltip: Stations (like Bewitching Table or Sharpening Station) automatically grant their infinite buffs to nearby players.
	}

	TorchGodEX: {
		Label: "[i:5043] Torch God's Favor Automatically Swaps Placed Torches"
		Tooltip: Obeys true torch luck, which may differ from Torch God's Favor. For example, swaps to Bone Torches to increase luck where other torches are not applicable.
	}

	BannerRecipes: {
		Label: "[i:1683] Banner Recipes"
		Tooltip: Adds recipes to convert banners into rare items dropped by the banner's enemy. Prevents statue spawned enemies from incrementing banner counts.
	}

	ContainerRecipes: {
		Label: "[i:WoodenCrate] Container Recipes"
		Tooltip: Adds recipes to convert Crates, Treasure Bags, Herb Bags and other containers to various items that can drop from them.
	}

	MiscRecipes: {
		Label: "[i:Wood] Miscellaneous Recipes"
		Tooltip: Adds various miscellaneous recipes.
	}

	NPCSales: {
		Label: "[i:267] Extra Town NPC sales"
		Tooltip: Adds extra item sales to various NPCs.
	}

	CatchNPCs: {
		Label: "[i:267] Catch Town NPCs"
		Tooltip: Adds the ability to catch NPCs with a Bug Net, move them around in your inventory, and place them down wherever you want.
	}

	Mutant: {
		Label: "[i:Fargowiltas/MutantMask] [c/ffffff:{$Mods.Fargowiltas.NPCs.Mutant.DisplayName} {$Mods.Fargowiltas.Configs.Common.CanSpawn}]"
		Tooltip: ""
	}

	Abom: {
		Label: "[i:Fargowiltas/AbominationnMask] [c/ffffff:{$Mods.Fargowiltas.NPCs.Abominationn.DisplayName} {$Mods.Fargowiltas.Configs.Common.CanSpawn}]"
		Tooltip: ""
	}

	Devi: {
		Label: "[i:Fargowiltas/DevianttMask] [c/ffffff:{$Mods.Fargowiltas.NPCs.Deviantt.DisplayName} {$Mods.Fargowiltas.Configs.Common.CanSpawn}]"
		Tooltip: ""
	}

	Lumber: {
		Label: "[i:Fargowiltas/LumberjackMask] [c/ffffff:{$Mods.Fargowiltas.NPCs.LumberJack.DisplayName} {$Mods.Fargowiltas.Configs.Common.CanSpawn}]"
		Tooltip: ""
	}

	Squirrel: {
		Label: "[i:239] [c/ffffff:{$Mods.Fargowiltas.NPCs.Squirrel.DisplayName} {$Mods.Fargowiltas.Configs.Common.CanSpawn}]"
		Tooltip: ""
	}

	Halloween: {
		Label: "[i:1774] Halloween Season"
		Tooltip: ""
	}

	Christmas: {
		Label: "[i:1869] Christmas Season"
		Tooltip: ""
	}

	DrunkWorld: {
		Label: "[i:353] Drunk World"
		Tooltip: ""
	}

	BeeWorld: {
		Label: "[i:1133] Bee World"
		Tooltip: ""
	}

	WorthyWorld: {
		Label: "[i:2107] For the Worthy World"
		Tooltip: ""
	}

	CelebrationWorld: {
		Label: "[i:3732] Celebration World"
		Tooltip: ""
	}

	ConstantWorld: {
		Label: "[i:5109] Constant World"
