BattleCry: {
	DisplayName: Battle Horn
	Tooltip:
		'''
		Left click to toggle increased spawn rates
		Right click to toggle decreased spawn rates
		May also be toggled between modes by right clicking the item in the inventory
		'''
	Battle: Battle
	Calming: Calming
	Activated: activated
	Deactivated: deactivated
	// {Battle / Calming} Cry {activated / deactivated} for {playerName}{punctuation}
	CryText: "{0} Cry {1} for {2}{3}"
}

DeathFruit: {
	DisplayName: Death Fruit
	Tooltip:
		'''
		Left click to decrease the amount of Life Crystals, or Life Fruit if you have any, by 1
		If both are 0, decreases base maximum health by 20, down to a minimum of 20
		Right click to reverse 1 use of the latter effect, otherwise remove all Life Fruits
		'''
}

