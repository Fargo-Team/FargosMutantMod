}

BoomShuriken: {
	DisplayName: Взрывной сюрикен
	Tooltip:
		'''
		Взрывается при контакте с блоками, разрушая их
		Соответствует мощности и скорость вашей самой сильной кирки
		Скорость использования увеличивается с вашими бонусами к скорости добычи
		«Самый быстрый способ через что-то прокопать — взорвать это!»
		'''
}

CityBuster: {
	DisplayName: Разрушитель городов
	Tooltip:
		'''
		Разрушает блоки на большой площади
		Не убирает стены
		Старается не разрушать структуры, помеченные как важные
		Используйте на свой страх и риск
		'''
}

DoubleObsidianInstabridge: {
	DisplayName: Двойной обсидиановый МоментМост
	Tooltip:
		'''
		Создаёт 2 моста из обсидиановых платформ, проходящих через весь мир
		Также убирает блоки между и над платформами
		Нижний мост появится у курсора
		Старается не разрушать структуры, помеченные как важные
		Используйте на свой страх и риск
		'''
}

GraveBuster: {
	DisplayName: Разрушитель могил
