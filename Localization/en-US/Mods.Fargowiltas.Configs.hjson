		Tooltip: ""
	}

	EnemyHealth: {
		Label: "[i:29] Enemy Health"
		Tooltip: Multiplies the health of all enemies.
	}

	BossHealth: {
		Label: "[i:29] Boss Health"
		Tooltip: Multiplies the health of all bosses. Highest multiplier between this or Enemy Health is applied.
	}

	EnemyDamage: {
		Label: "[i:3507] Enemy Damage"
		Tooltip: Multiplies post-mitigation damage of all enemies and projectiles.
	}

	BossDamage: {
		Label: "[i:3507] Boss Damage"
		Tooltip: Multiplies post-mitigation damage of all bosses. Highest multiplier between this or Enemy Damage is applied.
	}

	BossApplyToAllWhenAlive: {
		Label: Boss Multipliers Apply Universally
		Tooltip: Boss Health and Boss Damage configs apply to all enemies while a boss is alive, rather than just bosses themselves.
	}

	PiggyBankAcc: {
		Label: "[i:87] Informational and Construction item inventory effects work in Piggy Bank"
		Tooltip: ""
	}

	ModdedPiggyBankAcc: {
		Label: "[i:87] Modded item inventory effects work in Piggy Bank"
		Tooltip: ""
	}

	StalkerMoneyTrough: {
		Label: "[i:3213] Stalker Money Trough"
		Tooltip: The Money Trough follows you around in the world.
	}

	RottenEggs: {
		Label: "[i:1809] Powerful Rotten Eggs"
		Tooltip: Drastically increases the damage that Rotten Eggs deal to NPCs.
	}

	SaferBoundNPCs: {
		Label: "[i:1274] Rescuable Town NPCs take no contact damage"
		Tooltip: ""
	}

	ExtractSpeed: {
		Label: "[i:997] Increased Extractinator Speed"
		Tooltip: ""
	}

	PylonsIgnoreEvents: {
		Label: "[i:4876] Pylons Ignore Events"
		Tooltip: You can use Pylons even if an Event is active.
	}

	SafeTerraformers: {
		Label: "[i:Fargowiltas/InstaBridge] Safe Terraformers"
		Tooltip:
			'''
			Terraformers such as Instabridge and City Buster avoid destroying any areas added to the Important Structures list.
			This option is overly safe and will often avoid destroying even common things, such as cavern houses.
			'''
	}

	DisableTombstones: {
		Label: "[i:Fargowiltas/GraveBuster] Disable Tombstones"
		Tooltip: Makes Tombstones not spawn when players die.
	}

	ExtraBuffSlots: {
		Label: "[i:IronskinPotion] Extra Buff Slots"
		Tooltip: Grants 22 additional buff slots for all players.
	}

	AnglerQuestPity: {
		Label: "[i:AnglerTackleBag] Angler Quest Pity"
		Tooltip: Makes Angler give his important items at certain quests if he hasn't dropped them yet.
	}

	InstantItems: {
		Label: "[i:Dynamite] Instant Items"
		Tooltip: Enables/disables Insta items such as the InstaHouse
	}
}

FargoClientConfig: {
	DisplayName: Client Config

	AutoReforge: {
		Label: "[s:Fargowiltas/Reforge] Automatic Reforge"
		Tooltip: Modifies goblin tinkerer's reforge menu
	}

	ExpandedTooltips: {
		Label: "[i:171] More tooltips indicate Mutant Mod changes"
		Tooltip: ""
	}

	ExactTooltips: {
		Label: "[i:171] Tooltips display exact item speed and knockback"
		Tooltip: Item speed is listed in use time, meaning bigger number = slower.
	}

	ColoredDamageTypes: {
		Label: "[i:171] Damage tooltips are colored by damage type"
		Tooltip: ""
	}

	DoubleTapDashDisabled: {
		Label: "[i:3097] Disable double-tap for dashes"
		Tooltip: Prevent dashes from using the normal double-tap keybind. The Dash key is available regardless of this config.
	}

	DoubleTapSetBonusDisabled: {
		Label: "[i:3776] Disable double-tap for Set Bonuses"
		Tooltip: Prevent set bonuses from using the normal double-tap keybind. The Set Bonus key is available regardless of this config.
	}

	DebuffOpacity: {
		Label: "[i:1612] Debuff Display Max Opacity"
		Tooltip: ""
	}

	DebuffFaderRatio: {
		Label: "[i:1612] Debuff Duration Fader Strength"
		Tooltip: ""
	}

	HideTogglerWhenInventoryIsClosed: {
		Label: Only show effect toggler when inventory is open
		Tooltip: If true, the effect toggler is automatically hidden when your inventory is closed.
	}

	ToggleSearchReset: {
		Label: Accessory Effects menu resets search bar when closed
		Tooltip: ""
	}

	TransparentFriendlyProjectiles: {
		Label: "[i:1309] Transparent Friendly Projectiles"
		Tooltip: Use with vanilla setting for Quality at Medium or Low for best results.
	}

	MultiplayerDeathSpectate: {
		Label: "[i:3230] Multiplayer Death Spectate"
		Tooltip: ""
	}

	DisableAllScopeView: {
		Label: "[i:RifleScope][i:SniperRifle] Toggle All Scoped Binocular Views"
		Tooltip: Allows toggling Scoped Binocular Views
	}

	Headers: {
		UserInterface: User Interface
		Misc: Miscellaneous
	}

	AnimatedRecipeGroups: {
		Label: "[i:9] Animated Recipe Groups"
		Tooltip: Whether recipe group sprites should flip through the viable items in the recipe group when displayed.
	}

	HideUnlimitedBuffs: {
		Label: "[i:292] Hide unlimited buffs in tray"
		Tooltip: ""
	}

	NoTransparentPets: {
		Label: "[i:2019] No Transparent Pets"
		Tooltip: If true, pets become exempt from friendly projectile transparency.
	}
}

