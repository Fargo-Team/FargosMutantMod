}

HalfInstavator: {
	DisplayName: Полу-Моментуннель
	Tooltip:
		'''
		Бросает бомбу, которая моментально создаёт половину туннеля до Преисподней
		Не копает дальше определённой глубины
		Старается не разрушать структуры, помеченные как важные
		Не используйте, если ниже находятся важные постройки
		'''
}

InstaBridge: {
	DisplayName: МоментМост
	Tooltip:
		'''
		Создаёт мост из платформ, проходящий через весь мир
		Также убирает блоки над платформами
