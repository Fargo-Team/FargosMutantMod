BattleCry: {
	DisplayName: 战争号角
	Tooltip:
		'''
		左键使用使刷怪率提高 10 倍
		右键使用使刷怪率降低，降低倍数随游戏进程增加
		'''
	Battle: 战争
	Calming: 镇静
	Activated: 生效
	Deactivated: 停止生效
	// {Battle / Calming} Cry {activated / deactivated} for {playerName}{punctuation}
	CryText: "{0}号角已对{2}{1}{3}"
}

DeathFruit: {
	DisplayName: 死亡果实
	Tooltip:
		'''
		左键单击会永久性的减少20或5生命值上限（根据是否使用过生命果来决定）
		生命上限最低不会低于20
		生命上限低于100时右键单击可撤销该物品的上一次使用
		'''
}

InstantResearch: {
	DisplayName: 一键研究
	Tooltip:
		'''
		调 试 用 物 品
		研究所有物品
		'''
	ResearchText: 已研究{0}个物品
}

MapViewer: {
	DisplayName: 失落的王之地图
	Tooltip: 点亮整个地图
}

ModeToggle: {
	DisplayName: 世界令牌
	Tooltip:
		'''
		左键使用以切换世界难度
		右键使用以开关旅途模式（在多人游戏下会出现问题）
		'''
	Journey: 旅行模式已开启！
	Normal: 经典模式已开启！
	Expert: 专家模式已开启！
	Master: 大师模式已开启！
}

PortableSundial: {
	DisplayName: 便携式日晷
	Tooltip:
		'''
		左键单击可立即切换时间
		可以在黎明，中午，黄昏和午夜之间切换时间
		右键点击可激活魔法日晷效果
